# DeepSeek
DEEPSEEK_API_KEY=replace_with_your_api_key

# MySQL container
MYSQL_DATABASE=weather_agent
MYSQL_USER=weather_agent
MYSQL_PASSWORD=replace_with_app_password
MYSQL_ROOT_PASSWORD=replace_with_root_password
MYSQL_PORT=3306
TZ=Asia/Shanghai

# Flask runs on the host during local development.
DATABASE_URL=mysql+pymysql://weather_agent:replace_with_app_password@127.0.0.1:3306/weather_agent?charset=utf8mb4

# Flask server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
